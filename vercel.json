{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "services": {
    "frontend": {
      "root": "app/",
      "framework": "sveltekit",
      "installCommand": "bun install",
      "buildCommand": "bun run build",
      "devCommand": "bun run dev -- --host 0.0.0.0"
    },
    "backend": {
      "root": "./",
      "entrypoint": "src/main.rs",
      "devCommand": "cargo run --bin main"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/:name/:num",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/:name",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}