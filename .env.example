PG_DATABASE_URL="postgres://user:password@localhost:5432/mydatabase"
# Generate with: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"
# Set to true in production HTTPS deployments
AUTH_COOKIE_SECURE="false"

# Public origin that serves /api/auth (Vite dev proxy: http://localhost:5173 or your app URL)
AUTH_BASE_URL="http://localhost:5173"
# Frontend origin for post-OAuth redirect and CORS
FRONTEND_URL="http://localhost:5173"

GOOGLE_CLIENT_ID="1234567890-abcdefg.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="Iv1.0123456789abcdef"
GITHUB_CLIENT_SECRET="your-github-client-secret"