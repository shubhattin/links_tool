{
  "name": "links-tool",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "sync": "svelte-kit sync",
    "openapi-ts": "openapi-ts",
    "sync-api": "bash ../scripts/sync-api.sh",
    "check-api": "bash ../scripts/check-api-codegen.sh",
    "build": "bash ../scripts/sync-api.sh --release && svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && bun run check-api && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hey-api/openapi-ts": "0.97.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.17.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/svelte-query-devtools": "^6.1.33",
    "@tanstack/table-core": "^8.21.3",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.9.1",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.55.10",
    "svelte-check": "^4.4.8",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14"
  },
  "type": "module",
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.33",
    "ky": "^2.0.2",
    "mode-watcher": "^1.1.0",
    "ms": "^2.1.3",
    "svelte-icons-pack": "^3.1.3",
    "zod": "^4.4.3"
  }
}
